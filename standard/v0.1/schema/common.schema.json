{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json",
  "title": "Semantic Review Artifact Format common definitions",
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitBranch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:\\.\\.|//|@\\{|\\\\|[ ~^:?*\\[]))(?!.*(?:/|\\.|\\.lock)$)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?\\/)(?!.*\\/\\.\\.?$)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "requirementRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*#[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "nodeRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "lineSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lineRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "old": {
          "$ref": "#/$defs/lineSpan"
        },
        "new": {
          "$ref": "#/$defs/lineSpan"
        }
      },
      "anyOf": [
        {
          "required": [
            "old"
          ]
        },
        {
          "required": [
            "new"
          ]
        }
      ]
    },
    "nodeFileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "classification"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "classification": {
          "enum": [
            "behavior",
            "refactor",
            "test",
            "documentation",
            "configuration",
            "dependency",
            "migration",
            "generated",
            "chore",
            "trivial"
          ]
        },
        "hunks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "lineRanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lineRange"
          }
        }
      },
      "not": {
        "required": [
          "hunks",
          "lineRanges"
        ]
      }
    },
    "changeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "changes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nodeFileChange"
          }
        }
      }
    },
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "kind": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed"
          ]
        },
        "previousPath": {
          "$ref": "#/$defs/repositoryPath"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "renamed"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "previousPath"
            ]
          },
          "else": {
            "not": {
              "required": [
                "previousPath"
              ]
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "summary",
        "rationale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "requirement",
            "engineering"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nodeRefs": {
          "$ref": "#/$defs/nodeRefs"
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "riskIfWrong"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "riskIfWrong": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nodeRefs": {
          "$ref": "#/$defs/nodeRefs"
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "approach",
        "reasonRejected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "approach": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reasonRejected": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nodeRefs": {
          "$ref": "#/$defs/nodeRefs"
        }
      }
    },
    "failedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "approach",
        "outcome",
        "lesson"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "approach": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "outcome": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "lesson": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nodeRefs": {
          "$ref": "#/$defs/nodeRefs"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mitigation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nodeRefs": {
          "$ref": "#/$defs/nodeRefs"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "automated",
            "manual",
            "analysis"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-run"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "command": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nodeRefs": {
          "$ref": "#/$defs/nodeRefs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "automated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        }
      ]
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nodeRefs": {
          "$ref": "#/$defs/nodeRefs"
        }
      }
    }
  }
}
