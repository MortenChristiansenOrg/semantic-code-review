{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-code-review.dev/schemas/v0.1/stage.schema.json",
  "title": "Semantic Implementation Artifact Format stage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "summary",
    "dependsOn",
    "specificationRefs",
    "nodes",
    "change",
    "rationale",
    "decisions",
    "assumptions",
    "alternatives",
    "failedAttempts",
    "risks",
    "validation",
    "openQuestions"
  ],
  "properties": {
    "$schema": {
      "const": "https://semantic-code-review.dev/schemas/v0.1/stage.schema.json"
    },
    "id": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/id"
    },
    "title": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/nonEmptyString"
    },
    "summary": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/nonEmptyString"
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/id"
      }
    },
    "specificationRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/specificationRef"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/changeNode"
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "baseBranch",
        "baseRevision",
        "headRevision",
        "files"
      ],
      "properties": {
        "branch": {
          "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/gitBranch"
        },
        "baseBranch": {
          "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/gitBranch"
        },
        "baseRevision": {
          "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/sha1"
        },
        "headRevision": {
          "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/sha1"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/fileChange"
          }
        }
      }
    },
    "rationale": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/nonEmptyString"
    },
    "decisions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/decision"
          },
          {
            "type": "object",
            "required": [
              "nodeRefs"
            ]
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/assumption"
          },
          {
            "type": "object",
            "required": [
              "nodeRefs"
            ]
          }
        ]
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/alternative"
          },
          {
            "type": "object",
            "required": [
              "nodeRefs"
            ]
          }
        ]
      }
    },
    "failedAttempts": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/failedAttempt"
          },
          {
            "type": "object",
            "required": [
              "nodeRefs"
            ]
          }
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/risk"
          },
          {
            "type": "object",
            "required": [
              "nodeRefs"
            ]
          }
        ]
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/validationEvidence"
          },
          {
            "type": "object",
            "required": [
              "nodeRefs"
            ]
          }
        ]
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/openQuestion"
          },
          {
            "type": "object",
            "required": [
              "nodeRefs"
            ]
          }
        ]
      }
    }
  }
}
