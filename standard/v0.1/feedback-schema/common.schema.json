{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json",
  "title": "Semantic review feedback common definitions",
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$)[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "author",
        "body",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "author": {
          "enum": [
            "user",
            "agent"
          ]
        },
        "body": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitBranch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:/|$))(?!/)(?!.*(?:\\.\\.|//|@\\{|\\\\|[ ~^:?*\\[]))(?!.*(?:/|\\.|\\.lock)$)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?\\/)(?!.*\\/\\.\\.?$)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "specification",
            "criterion",
            "stage",
            "insight",
            "file",
            "line"
          ]
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "specificationId": {
          "$ref": "#/$defs/id"
        },
        "criterionId": {
          "$ref": "#/$defs/id"
        },
        "stageId": {
          "$ref": "#/$defs/id"
        },
        "stageBranch": {
          "$ref": "#/$defs/gitBranch"
        },
        "stageHead": {
          "$ref": "#/$defs/sha1"
        },
        "collection": {
          "enum": [
            "decisions",
            "assumptions",
            "alternatives",
            "failedAttempts",
            "risks",
            "validation",
            "openQuestions"
          ]
        },
        "itemId": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "side": {
          "enum": [
            "old",
            "new"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "specification"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "specificationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "criterion"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "specificationId",
              "criterionId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "stage"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "stageId",
              "stageBranch",
              "stageHead"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "insight"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "stageId",
              "stageBranch",
              "stageHead",
              "collection",
              "itemId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "stageId",
              "stageBranch",
              "stageHead",
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "line"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "stageId",
              "stageBranch",
              "stageHead",
              "path",
              "side",
              "line"
            ]
          }
        }
      ]
    }
  }
}
