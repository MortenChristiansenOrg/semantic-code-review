{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-code-review.dev/schemas/feedback/v0.1/thread.schema.json",
  "title": "Semantic review feedback thread",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "batchId",
    "status",
    "comments",
    "target",
    "createdAt"
  ],
  "properties": {
    "$schema": {
      "const": "https://semantic-code-review.dev/schemas/feedback/v0.1/thread.schema.json"
    },
    "id": {
      "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/id"
    },
    "batchId": {
      "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/id"
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "resolved",
        "approved"
      ]
    },
    "comments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/comment"
      }
    },
    "target": {
      "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/target"
    },
    "assignedStageId": {
      "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/id"
    },
    "assignedStageHead": {
      "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/sha1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "resolution": {
      "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/resolution"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "resolved",
              "approved"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "resolution"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "draft"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "assignedStageId",
          "assignedStageHead"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resolution": {
            "type": "object",
            "required": [
              "approvedAt"
            ]
          }
        }
      }
    }
  ]
}
