{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-code-review.dev/schemas/feedback/v0.1/batch.schema.json",
  "title": "Semantic review feedback batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "status",
    "items",
    "createdAt"
  ],
  "properties": {
    "$schema": {
      "const": "https://semantic-code-review.dev/schemas/feedback/v0.1/batch.schema.json"
    },
    "id": {
      "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/id"
    },
    "title": {
      "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/nonEmptyString"
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "addressing",
        "resolved",
        "approved"
      ]
    },
    "items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://semantic-code-review.dev/schemas/feedback/v0.1/common.schema.json#/$defs/id"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
