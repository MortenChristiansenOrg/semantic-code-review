{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-code-review.dev/schemas/v0.1/manifest.schema.json",
  "title": "Semantic Review Artifact Format manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "reviewId",
    "title",
    "summary",
    "baseRevision",
    "targetBranch",
    "branchPrefix",
    "requirements",
    "stages"
  ],
  "properties": {
    "$schema": {
      "const": "https://semantic-code-review.dev/schemas/v0.1/manifest.schema.json"
    },
    "formatVersion": {
      "const": "0.1"
    },
    "reviewId": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/id"
    },
    "title": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/nonEmptyString"
    },
    "summary": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/nonEmptyString"
    },
    "baseRevision": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/sha1"
    },
    "targetBranch": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/gitBranch"
    },
    "branchPrefix": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/gitBranch"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/id"
      }
    },
    "stages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/id"
      }
    },
    "extensions": {
      "$ref": "https://semantic-code-review.dev/schemas/v0.1/common.schema.json#/$defs/extensions"
    }
  }
}
